{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickNote",
  "version": "2.0.0",
  "identifier": "com.joey.quicknote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickNote",
        "width": 1200,
        "height": 800,
        "resizable": true
      },
      {
        "label": "quickbar",
        "title": "QuickNote Quick Bar",
        "url": "index.html?window=quickbar",
        "width": 640,
        "height": 420,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
